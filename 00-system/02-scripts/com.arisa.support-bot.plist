<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  아리사 지원봇 (조회·질의) — 맥미니 launchd
  설치: cp 이 파일 ~/Library/LaunchAgents/ && launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.arisa.support-bot.plist

  ⚠️ EnvironmentVariables 2개는 필수다:
     - PATH: 비로그인 셸에는 node조차 없어 gws가 안 돈다(규정 동기화가 Drive를 탄다)
     - GOOGLE_WORKSPACE_CLI_KEYRING_BACKEND=file: 헤드리스라 기본 keyring이 안 열린다
  ⚠️ venv는 아리사와 공유한다 — 의존성이 같고, 별도로 만들 이유가 없다.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.arisa.support-bot</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/server-mini/do-better-workspace/20-operations/24-second-brain/.venv311/bin/python</string>
        <string>-u</string>
        <string>/Users/server-mini/do-better-workspace/00-system/02-scripts/arisa-support-bot.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/server-mini/do-better-workspace</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/server-mini/.npm-global/bin:/Users/server-mini/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>GOOGLE_WORKSPACE_CLI_KEYRING_BACKEND</key>
        <string>file</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/tmp/arisa-support-bot.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/arisa-support-bot.log</string>
</dict>
</plist>
